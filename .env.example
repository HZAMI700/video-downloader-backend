# Server configuration (Botkeep injects SERVER_PORT automatically)
SERVER_PORT=8000
HOST=0.0.0.0

# CORS Configuration - comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,https://video-downloader-frontend.vercel.app

# Download limits and temporary file management (Optimized for Botkeep 2GB Disk)
MAX_FILE_SIZE_MB=250
DOWNLOAD_TIMEOUT_SECONDS=300
DOWNLOAD_TTL_SECONDS=180
MAX_CONCURRENT_DOWNLOADS=2
MAX_TEMP_DIR_SIZE_MB=300
TEMP_DOWNLOAD_DIR=./downloads_temp

# AI Speech Transcription Configuration
# Providers: 'auto', 'groq', 'openai', 'deepgram', 'assemblyai'
# NOTE FOR BOTKEEP FREE TIER (2 GB RAM, 1.5 vCore, 2 GB Storage):
# Do NOT run local PyTorch/Whisper models inside the container to prevent OOM kills.
# Provide at least one external API key below:
TRANSCRIPTION_PROVIDER=auto
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
MAX_TRANSCRIPTION_FILE_SIZE_MB=100
MAX_TRANSCRIPTION_DURATION_SECONDS=3600

# Robin Darknet OSINT & OpenCode Inference API
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_MODEL=<OPENCODE_MODEL_ID>
TOR_SOCKS_PROXY=socks5h://tor:9050
ROBIN_AUTH_SECRET=

# Blackbird OSINT Email Checker
BLACKBIRD_ENABLED=true
BLACKBIRD_TIMEOUT_SECONDS=120
BLACKBIRD_AI_ENABLED=false
BLACKBIRD_RATE_LIMIT_PER_MINUTE=5
BLACKBIRD_AUTH_TOKEN=
